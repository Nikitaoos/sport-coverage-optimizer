<?xml version="1.0" encoding="UTF-8"?>
<!--
    Описание спортивного объекта для оптимизационной модели покрытия.
    Единицы измерения: метры (координаты x, y).
    Начало координат — левый нижний угол объекта.
-->
<venue name="Стадион «Пример»" type="stadium" capacity="5000">

    <!--
        Зоны наблюдения (sectors) — области, которые должны быть покрыты камерами.
        x, y — левый нижний угол зоны; width, height — размеры.
        priority: 1 (высокий) .. 3 (низкий)
    -->
    <sectors>
        <sector id="S1" name="Северная трибуна"  x="20" y="65" width="60" height="12" priority="1"/>
        <sector id="S2" name="Южная трибуна"     x="20" y="3"  width="60" height="12" priority="1"/>
        <sector id="S3" name="Западная трибуна"  x="3"  y="15" width="17" height="50" priority="2"/>
        <sector id="S4" name="Восточная трибуна" x="80" y="15" width="17" height="50" priority="2"/>
    </sectors>

    <!--
        Кандидатные позиции для стационарных камер.
        x, y — координаты установки; azimuth — ориентация оси объектива (°, 0=север, по часовой).
        angle_h — горизонтальный угол обзора (°); range_m — дальность уверенного обзора (м).
        cost — стоимость установки + год эксплуатации (руб.).
    -->
    <camera_positions>
        <position id="C1"  x="3"  y="77" azimuth="315" angle_h="80" range_m="35" cost="80000"/>
        <position id="C2"  x="35" y="77" azimuth="270" angle_h="80" range_m="35" cost="80000"/>
        <position id="C3"  x="65" y="77" azimuth="270" angle_h="80" range_m="35" cost="80000"/>
        <position id="C4"  x="97" y="77" azimuth="225" angle_h="80" range_m="35" cost="80000"/>
        <position id="C5"  x="3"  y="3"  azimuth="45"  angle_h="80" range_m="35" cost="80000"/>
        <position id="C6"  x="35" y="3"  azimuth="90"  angle_h="80" range_m="35" cost="80000"/>
        <position id="C7"  x="65" y="3"  azimuth="90"  angle_h="80" range_m="35" cost="80000"/>
        <position id="C8"  x="97" y="3"  azimuth="135" angle_h="80" range_m="35" cost="80000"/>
        <position id="C9"  x="3"  y="40" azimuth="0"   angle_h="80" range_m="35" cost="80000"/>
        <position id="C10" x="97" y="40" azimuth="180" angle_h="80" range_m="35" cost="80000"/>
        <position id="C11" x="22" y="77" azimuth="300" angle_h="80" range_m="30" cost="70000"/>
        <position id="C12" x="78" y="77" azimuth="240" angle_h="80" range_m="30" cost="70000"/>
        <position id="C13" x="22" y="3"  azimuth="60"  angle_h="80" range_m="30" cost="70000"/>
        <position id="C14" x="78" y="3"  azimuth="120" angle_h="80" range_m="30" cost="70000"/>
        <position id="C15" x="3"  y="55" azimuth="10"  angle_h="70" range_m="28" cost="65000"/>
        <position id="C16" x="3"  y="25" azimuth="350" angle_h="70" range_m="28" cost="65000"/>
        <position id="C17" x="97" y="55" azimuth="170" angle_h="70" range_m="28" cost="65000"/>
        <position id="C18" x="97" y="25" azimuth="190" angle_h="70" range_m="28" cost="65000"/>
        <position id="C19" x="20" y="65" azimuth="330" angle_h="75" range_m="30" cost="70000"/>
        <position id="C20" x="80" y="65" azimuth="210" angle_h="75" range_m="30" cost="70000"/>
    </camera_positions>

    <!--
        Запретные зоны для полётов БПЛА (например, над игровым полем).
        x, y — левый нижний угол; width, height — размеры.
    -->
    <forbidden_zones>
        <zone id="FZ1" name="Игровое поле" x="20" y="15" width="60" height="50"/>
    </forbidden_zones>

    <!--
        Параметры БПЛА.
        range_m — максимальная длина маршрута одного аппарата (м);
        obs_radius_m — радиус полосы наблюдения (м);
        max_units — бюджет флота (шт.);
        cost_per_unit — стоимость аренды/эксплуатации (руб/мероприятие).
    -->
    <drone_params range_m="50" obs_radius_m="12" max_units="4" cost_per_unit="15000"/>

</venue>
